    "customer": {
      "description": "Bank customer master containing persons and businesses.",
      "grain": "One row per customer.",
      "primary_key": [
        "customer_id"
      ],
      "business_key": [
        "customer_id"
      ],
      "columns": {
        "customer_id": {
          "type": "VARCHAR(20)",
