          "weights": {
            "PERSON": 0.85,
            "BUSINESS": 0.15
          },
          "sensitive": false
        },
        "first_name": {
          "type": "VARCHAR(100)",
          "nullable": true,
          "generator": "conditional",
          "condition": "customer_type == PERSON",
          "value_generator": "first_name",
          "sensitive": false
        },
        "last_name": {
          "type": "VARCHAR(100)",
          "nullable": true,
