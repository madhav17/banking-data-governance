      },
      "transaction_rules": {
        "standard_posting": "One row represents one posting affecting one customer account.",
        "internal_transfer": "Generate two postings with the same transaction_group_id: one debit and one credit, for the same amount.",
        "external_or_cash_activity": "One customer-account posting is sufficient for this simplified model because the counterparty is outside the modeled customer-account scope."
      }
