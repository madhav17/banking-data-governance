        "account_id",
        "business_date"
      ],
      "business_key": [
        "account_id",
        "business_date"
      ],
      "generation_strategy": {
        "type": "time_series",
        "parent": "account.account_id",
        "date_range": "generation_config.balance_date_range",
        "formula": "previous_closing_balance + credits - debits"
      },
      "columns": {
        "account_id": {
          "type": "VARCHAR(20)",
          "nullable": false,
          "generator": "foreign_key",
          "references": "account.account_id",
          "sensitive": false
        },
        "business_date": {
          "type": "DATE",
          "nullable": false,
