{
  "project": {
    "name": "banking-data-governance",
    "purpose": "Authoritative synthetic RAW banking data contract for the Snowflake governance take-home.",
    "target_layer": "RAW",
    "format": "CSV",
    "encoding": "UTF-8"
  },
  "generation_config": {
    "seed": 42,
    "output_directory": "data/generated/raw",
    "row_counts": {
      "branch": 10,
      "product": 15,
      "officer": 100,
      "customer": 5000,
      "account": 8000,
      "account_daily_balance": 240000,
      "transaction": 150000,
      "card": 5000,
      "loan": 1500,
      "loan_collateral": 1500,
      "gl_control_total": 30
    },
    "balance_date_range": {
      "start_date": "2026-08-01",
      "end_date": "2026-08-30"
    },
    "csv": {
      "include_header": true,
      "encoding": "UTF-8",
      "date_format": "YYYY-MM-DD",
      "timestamp_format": "YYYY-MM-DD HH:MM:SS",
      "null_representation": ""
    }
  },
  "generation_rules": {
    "customer_type_distribution": {
      "PERSON": 0.85,
      "BUSINESS": 0.15
    },
    "accounts": {
      "each_customer_has_at_least_one_account": true,
      "additional_accounts_randomly_assigned": true
    },
    "transactions": {
      "one_row_represents_one_account_posting": true,
      "internal_transfer_uses_two_postings": true,
      "internal_transfer_postings_share_transaction_group_id": true,
      "generate_for_active_accounts": true
    },
    "cards": {
      "generate_for_a_subset_of_accounts": true,
      "card_numbers_are_synthetic_only": true
    },
    "balances": {
      "closing_balance": "opening_balance + credits - debits",
      "next_day_opening_balance": "previous_day_closing_balance"
    },
    "gl_control_total": {
      "type": "derived_synthetic_control",
      "derived_from": "account_daily_balance",
      "aggregation": "SUM(closing_balance)",
      "group_by": [
        "business_date",
        "currency"
      ],
      "reconciliation_tolerance": 1.0,
      "purpose": "Persisted synthetic GL control dataset used to demonstrate deposit-balance reconciliation."
    }
  },
  "tables": {
    "branch": {
      "description": "Reference table for bank branches.",
      "grain": "One row per branch.",
      "primary_key": [
        "branch_id"
      ],
      "business_key": [
        "branch_code"
      ],
      "columns": {
        "branch_id": {
          "type": "VARCHAR(20)",
          "nullable": false,
          "generator": "id",
          "sensitive": false
        },
        "branch_code": {
          "type": "VARCHAR(20)",
          "nullable": false,
          "generator": "code",
          "sensitive": false
        },
        "branch_name": {
          "type": "VARCHAR(100)",
          "nullable": false,
          "generator": "branch_name",
          "sensitive": false
        },
        "region": {
          "type": "VARCHAR(50)",
          "nullable": false,
          "generator": "choice",
          "allowed_values": [
            "NORTH",
            "SOUTH",
            "EAST",
            "WEST"
          ],
          "sensitive": false
        },
        "city": {
          "type": "VARCHAR(100)",
          "nullable": false,
          "generator": "city",
          "sensitive": false
        },
        "state": {
          "type": "VARCHAR(100)",
          "nullable": false,
          "generator": "state",
          "sensitive": false
        },
        "postal_code": {
          "type": "VARCHAR(10)",
          "nullable": false,
          "generator": "postal_code",
          "sensitive": false
        },
        "branch_status": {
          "type": "VARCHAR(20)",
          "nullable": false,
          "generator": "choice",
          "allowed_values": [
            "ACTIVE",
            "INACTIVE"
          ],
          "sensitive": false
        }
      }
    },
