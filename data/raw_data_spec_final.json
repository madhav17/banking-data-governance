          "sensitive": false
        },
        "city": {
          "type": "VARCHAR(100)",
          "nullable": false,
          "generator": "city",
          "sensitive": false
        },
        "state": {
          "type": "VARCHAR(100)",
          "nullable": false,
          "generator": "state",
          "sensitive": false
        },
        "postal_code": {
          "type": "VARCHAR(10)",
          "nullable": false,
          "generator": "postal_code",
          "sensitive": false
        },
        "country": {
          "type": "VARCHAR(50)",
          "nullable": false,
          "generator": "constant",
          "value": "INDIA",
          "sensitive": false
