          "nullable": false,
          "generator": "constant",
          "value": "INR",
          "sensitive": false
        },
        "source_system": {
          "type": "VARCHAR(50)",
          "nullable": false,
          "generator": "constant",
          "value": "CORE_BANKING",
          "sensitive": false
        },
        "load_timestamp": {
          "type": "TIMESTAMP",
          "nullable": false,
          "generator": "timestamp",
          "sensitive": false
        }
      }
    },
