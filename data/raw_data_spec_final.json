          "sensitive": false
        },
        "closing_balance": {
          "type": "NUMBER(18,2)",
          "nullable": false,
          "generator": "derived",
          "sensitive": false
        },
        "available_balance": {
          "type": "NUMBER(18,2)",
          "nullable": false,
          "generator": "derived",
          "sensitive": false
        },
        "currency": {
